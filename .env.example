# Optional: Tavily API key for fallback search
TAVILY_API_KEY=

# Optional: SearXNG instance URL for fallback search
SEARX_URL=

# Optional: Allow fetching private IP addresses (off by default for security)
# ALLOW_PRIVATE_URLS=true

# Optional: Custom request timeout in ms (default: 15000 for fetch_page, 8000 per engine for search)
# REQUEST_TIMEOUT_MS=15000