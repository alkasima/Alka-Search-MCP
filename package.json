{
  "name": "@alkasima/alka-search-mcp",
  "version": "1.0.2",
  "description": "Free web search MCP server - no Docker, no paid API, just fetch-based search",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alka-search-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "search",
    "web-search",
    "model-context-protocol",
    "free",
    "open-source"
  ],
  "author": "Kasim (@alkasima)",
  "license": "MIT",
  "homepage": "https://github.com/alkasima/Alka-Search-MCP#readme",
  "bugs": {
    "url": "https://github.com/alkasima/Alka-Search-MCP/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alkasima/Alka-Search-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^25.0.0",
    "turndown": "^7.2.0",
    "undici": "^7.30.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
